font = "JetBrainsMono Nerd Font"

font-symbol = [
    "JetBrainsMono Nerd Font",
    "FontAwesome",
]

font-color = "Noto Color Emoji"

# use Semibold as the Bold style
style-bold = "Regular"
font-size = 15
# dpi = auto

colorscheme = "yaru"
# bg-blur = true
# bg-color = rgba(0,0,0,0.7)


visual-bell = none
term = "xterm-256color"
title = "Terminal"

# Set the type of window decorations hint (depends on window manager support)
# decorations = minimal
# scrollback = 1000
# always-underline-links = true

bind-key-debug=Ctrl+Shift+Return
bind-key-enlarge=Ctrl+Shift+equal
bind-key-shrink=Ctrl+Shift+minus
bind-key-copy=Alt+c
bind-key-paste=Alt+v
