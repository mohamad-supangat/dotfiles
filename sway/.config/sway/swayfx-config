include config


# ganti scrcpy dengan qtscrcpy ketika menggunakan native wayland
# unbindsym $mod+Shift+s
# bindsym $mod+Shift+s exec pkill QtScrcpy;exec qtscrcpy
xwayland disable


blur enable
corner_radius 10
shadows disable
shadows_on_csd disable
# smart_gaps on
gaps inner 5
gaps outer 5
gaps bottom 5


animation_duration_ms 499
layer_effects "vibepanel" {
    blur enable;
    blur_xray enable;
    blur_ignore_transparent enable;
    shadows disable;
    corner_radius 20;
}
