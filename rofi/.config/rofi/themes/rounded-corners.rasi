/* ROUNDED THEME FOR ROFI - MATUGEN INTEGRATED */
/* Author: Newman Sanchez (https://github.com/newmanls) */
/* Integrated with Material You Colors */

* {
    /* --- THEME SETTINGS --- */
    font:   "Roboto 12";

    background-color:   transparent;
    text-color:         var(on-surface);

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          480;
    border-radius:  24px;

    background-color:   var(surface);
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   var(surface-container);
    border-color:       var(primary);

    border:         2px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: var(primary);
}

entry {
    placeholder:        "Search";
    placeholder-color:  var(on-surface-variant);
    text-color:         var(on-surface);
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       var(surface-container-high);
    background-color:   var(surface-container-high);
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;

    fixed-height: false;
}


element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
    /* Memastikan background item transparan agar mengikuti warna window */
    background-color: transparent;
}

/* Menghapus warna belang (alternate) bawaan Rofi pada item list */
element normal normal, element alternate normal {
    background-color:   var(surface-container-low);
    text-color:         var(on-surface);
}

element normal active {
    text-color: var(primary);
}

element alternate active {
    text-color: var(primary);
}

element selected normal, element selected active {
    background-color:   var(primary);
    text-color:         var(on-primary);
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
